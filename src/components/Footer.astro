---
import { site, navigation } from '../config/site';
const fields = [
  ['Registered company name', site.company.registeredName],
  ['Company number', site.company.number],
  ['Registered office', site.company.registeredOffice],
  ['Registered in', site.company.jurisdiction],
];
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <a class="footer-mark" href="/" aria-label="Tarian Ventures — home"><img src="/brand/logos/tarian-mark-white.svg" alt="Tarian Ventures" width="100" height="100" /></a>
      <nav aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/cookies/">Cookies</a></nav>
    </div>
    <nav class="footer-navigation" aria-label="Footer">{navigation.filter(item => item.href !== '/').map(item => <a href={item.href}>{item.label}</a>)}</nav>
    <div class="footer-bottom">
      <div><p>© {new Date().getFullYear()} {site.company.registeredName ?? 'Tarian Ventures'}</p><a href={`mailto:${site.contact.general}`}>{site.contact.general}</a></div>
      <div class="company-information">
        <dl>{fields.map(([label, value]) => <div><dt>{label}</dt><dd>{value ?? 'Not yet verified'}</dd></div>)}</dl>
      </div>
    </div>
  </div>
</footer>
