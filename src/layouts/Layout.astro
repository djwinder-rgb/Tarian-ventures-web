---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, organizationJson } from '../config/site';
import '../styles/global.css';
interface Props { title: string; description: string; notFound?: boolean; }
const { title, description, notFound = false } = Astro.props;
const canonical = site.productionOrigin && !notFound ? new URL(Astro.url.pathname, site.productionOrigin).href : null;
const image = site.productionOrigin ? new URL('/brand/tarian-social.png', site.productionOrigin).href : '/brand/tarian-social.png';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Tarian Ventures</title>
    <meta name="description" content={description} />
    {(!site.publicationReviewed || notFound) && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tarian Ventures" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={`${title} | Tarian Ventures`} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tarian Ventures — Building businesses around problems worth solving." />
    <meta name="theme-color" content="#13564D" />
    <link rel="icon" type="image/svg+xml" href="/brand/icons/tarian-favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icons/tarian-favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/icons/tarian-app-icon-180.png" />
    <script type="application/ld+json" is:inline set:html={organizationJson} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
